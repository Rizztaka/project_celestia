{
  "contractVersion": 1,
  "key": "Lisa",
  "gameId": 10000006,
  "name": "Lisa",
  "description": "The languid but knowledgeable Librarian of the Knights of Favonius, deemed by Sumeru Akademiya to be their most distinguished graduate in the past two centuries.",
  "element": "Electro",
  "weaponType": "Catalyst",
  "rarity": 4,
  "forms": [],
  "talents": [
    {
      "key": "combat1",
      "name": "Lightning Touch",
      "description": "Normal Attack\nPerforms up to 4 lightning attacks that deal Electro DMG.\n\nCharged Attack\nConsumes a certain amount of Stamina to deal AoE Electro DMG after a short casting time.\n\nPlunging Attack\nGathering the might of Electro, Lisa plunges towards the ground from mid-air, damaging all opponents in her path. Deals AoE Electro DMG upon impact with the ground.",
      "kind": "normal",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat2",
      "name": "Violet Arc",
      "description": "Channels the power of lightning to sweep bothersome matters away.\n\nPress\nReleases a homing Lightning Orb.\nOn hit, it deals Electro DMG and applies a stack of the Conductive status (max 3 stacks) to opponents in a small AoE.\n\nHold\nAfter an extended casting time, calls down lightning from the heavens, dealing massive Electro DMG to all nearby opponents.\nDeals great amounts of extra damage to opponents based on the number of Conductive stacks applied to them, and clears their Conductive status.",
      "kind": "skill",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat3",
      "name": "Lightning Rose",
      "description": "Summons a Lightning Rose that unleashes powerful lightning bolts, launching surrounding opponents and dealing Electro DMG.\nThe Lightning Rose will continuously emit lightning to knock back opponents and deal Electro DMG throughout the ability's duration.",
      "kind": "burst",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive1",
      "name": "Induced Aftershock",
      "description": "Hits by Charged Attacks apply Violet Arc's Conductive status to opponents.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive2",
      "name": "Static Electricity Field",
      "description": "Opponents hit by Lightning Rose have their DEF decreased by 15% for 10s.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive3",
      "name": "General Pharmaceutics",
      "description": "When Lisa crafts a potion, she has a 20% chance to refund a portion of the crafting materials used.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    }
  ],
