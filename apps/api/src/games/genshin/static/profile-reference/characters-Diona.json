{
  "contractVersion": 1,
  "key": "Diona",
  "gameId": 10000039,
  "name": "Diona",
  "description": "A young lady who has inherited trace amounts of non-human blood. She is the incredibly popular bartender of the Cat's Tail tavern.",
  "element": "Cryo",
  "weaponType": "Bow",
  "rarity": 4,
  "forms": [],
  "talents": [
    {
      "key": "combat1",
      "name": "Kätzlein Style",
      "description": "Normal Attack\nPerforms up to 5 consecutive shots with a bow.\n\nCharged Attack\nPerforms a more precise Aimed Shot with increased DMG.\nWhile aiming, biting frost will accumulate on the arrowhead. A fully charged frost arrow will deal Cryo DMG.\n\nPlunging Attack\nFires off a shower of arrows in mid-air before falling and striking the ground, dealing AoE DMG upon impact.",
      "kind": "normal",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat2",
      "name": "Icy Paws",
      "description": "Fires an Icy Paw that deals Cryo DMG to opponents and forms a shield on hit.\nThe shield's DMG Absorption scales based on Diona's Max HP, and its duration scales off the number of Icy Paws that hit their target.\n\nPress\nRapidly fires off 2 Icy Paws.\n\nHold\nDashes back quickly before firing 5 Icy Paws.\nThe shield created by a Hold attack will gain a 75% DMG Absorption Bonus.\n\nThe shield has a 250% Cryo DMG Absorption Bonus, and will cause your active character to become affected by Cryo at the point of formation for a short duration.",
      "kind": "skill",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat3",
      "name": "Signature Mix",
      "description": "Tosses out a special cold brew that deals AoE Cryo DMG and creates a Drunken Mist in an AoE.\n\nDrunken Mist\n·Deals continuous Cryo DMG to opponents within the AoE.\n·Continuously regenerates the HP of characters within the AoE.",
      "kind": "burst",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive1",
      "name": "Cat's Tail Secret Menu",
      "description": "Characters shielded by Icy Paws have their Movement SPD increased by 10% and their Stamina Consumption decreased by 10%.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive2",
      "name": "Drunkards' Farce",
      "description": "Opponents who enter the AoE of Signature Mix have 10% decreased ATK for 15s.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive3",
      "name": "Complimentary Bar Food",
      "description": "When a Perfect Cooking is achieved on a dish with restorative effects, there is a 12% chance to obtain double the product.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    }
  ],
  "constellations": [
    {
      "key": "c1",
      "name": "A Lingering Flavor",
      "description": "Regenerates 15 Energy for Diona after the effects of Signature Mix end.",
      "kind": "constellation",
      "constellation": 1,
      "unlock": "constellation"
    },
    {
      "key": "c2",
      "name": "Shaken, Not Purred",
      "description": "Increases Icy Paws' DMG by 15%, and increases its shield's DMG Absorption by 15%.\nAdditionally, when paws hit their targets, creates a shield for other nearby characters on the field with 50% of the Icy Paws shield's DMG Absorption for 5s.",
      "kind": "constellation",
      "constellation": 2,
      "unlock": "constellation"
    },
    {
      "key": "c3",
      "name": "A—Another Round?",
      "description": "Increases the Level of Signature Mix by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 3,
      "unlock": "constellation"
    },
    {
      "key": "c4",
      "name": "Wine Industry Slayer",
      "description": "Within the radius of Signature Mix, Diona's charge time for aimed shots is reduced by 60%",
      "kind": "constellation",
      "constellation": 4,
