{
  "contractVersion": 1,
  "key": "Bennett",
  "gameId": 10000032,
  "name": "Bennett",
  "description": "A good-natured adventurer from Mondstadt who's unfortunately extremely unlucky.",
  "element": "Pyro",
  "weaponType": "Sword",
  "rarity": 4,
  "forms": [],
  "talents": [
    {
      "key": "combat1",
      "name": "Strike of Fortune",
      "description": "Normal Attack\nPerforms up to 5 rapid strikes.\n\nCharged Attack\nConsumes a certain amount of Stamina to unleash 2 rapid sword strikes.\n\nPlunging Attack\nPlunges from mid-air to strike the ground below, damaging opponents along the path and dealing AoE DMG upon impact.",
      "kind": "normal",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat2",
      "name": "Passion Overload",
      "description": "Bennett puts all his fire and passion for adventuring into his sword. Results may vary based on how fired up he is...\n\nPress\nA single, swift flame strike that deals Pyro DMG.\n\nHold (Short)\nCharges up, resulting in different effects when unleashed based on the Charge Level.\n·Level 1: Strikes twice, dealing Pyro DMG and launching opponents.\n·Level 2: Unleashes 3 consecutive attacks that deal impressive Pyro DMG, but the last attack triggers an explosion that launches both Bennett and the enemy.\nBennett takes no damage from being launched.",
      "kind": "skill",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat3",
      "name": "Fantastic Voyage",
      "description": "Bennett performs a jumping attack that deals Pyro DMG, creating an Inspiration Field.\n\nInspiration Field\n·If the health of a character within the AoE is equal to or falls below 70%, their health will continuously regenerate. The amount of HP restored scales off Bennett's Max HP.\n·If the health of a character within the AoE is higher than 70%, they gain an ATK Bonus that is based on Bennett's Base ATK.\n·Imbues characters within the AoE with Pyro.",
      "kind": "burst",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive1",
      "name": "Rekindle",
      "description": "Decreases Passion Overload's CD by 20%.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive2",
      "name": "Fearnaught",
      "description": "Within the area created by Fantastic Voyage, Passion Overload takes on the following effects:\n·CD is reduced by 50%.\n·Bennett will not be launched by the effects of Charge Level 2.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive3",
      "name": "It Should Be Safe...",
      "description": "When dispatched on an expedition in Mondstadt, time consumed is reduced by 25%.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    }
  ],
  "constellations": [
    {
      "key": "c1",
      "name": "Grand Expectation",
      "description": "Fantastic Voyage's ATK increase no longer has an HP restriction, and gains an additional 20% of Bennett's Base ATK.",
      "kind": "constellation",
      "constellation": 1,
      "unlock": "constellation"
    },
    {
      "key": "c2",
      "name": "Impasse Conqueror",
      "description": "When Bennett's HP falls below 70%, his Energy Recharge is increased by 30%.",
      "kind": "constellation",
      "constellation": 2,
      "unlock": "constellation"
    },
    {
      "key": "c3",
      "name": "Unstoppable Fervor",
      "description": "Increases the Level of Passion Overload by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 3,
      "unlock": "constellation"
    },
    {
      "key": "c4",
      "name": "Unexpected Odyssey",
      "description": "Using a Normal Attack as the second attack of Passion Overload's Charge Level 1 will perform a follow-up attack.\nThis additional attack does 135% of the second attack's DMG.",
      "kind": "constellation",
      "constellation": 4,
      "unlock": "constellation"
    },
    {
      "key": "c5",
      "name": "True Explorer",
      "description": "Increases the Level of Fantastic Voyage by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 5,
      "unlock": "constellation"
    },
    {
      "key": "c6",
      "name": "Fire Ventures With Me",
      "description": "Sword, Claymore, or Polearm-wielding characters inside Fantastic Voyage's radius gain a 15% Pyro DMG Bonus and their weapons are infused with Pyro.",
      "kind": "constellation",
      "constellation": 6,
      "unlock": "constellation"
    }
