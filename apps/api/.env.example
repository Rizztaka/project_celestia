# apps/api/.env.example
#
# Copy this file to .env and fill in all required values.
# Never commit the real .env file to version control.

# Application
NODE_ENV=development
PORT=4000
# Keep false for a directly reachable API. Use an exact hop count only when
# every network path has that many trusted proxies; otherwise use trusted CIDRs.
TRUST_PROXY=false
# Optional: unset for the bounded in-memory stores. Production with configured
# Redis fails closed on outages; local development/test uses bounded fallback.
# REDIS_URL="redis://localhost:6379"

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/celestia_db?schema=public"

# Authentication (required when auth module is implemented)
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-strong-random-secret"
# Access tokens are fixed to 15 minutes; retained for legacy tooling only.
JWT_EXPIRY="15m"
WEB_ORIGIN="http://localhost:5173"
API_ORIGIN="http://localhost:4000"
# Set WEB_ORIGIN and API_ORIGIN to HTTPS origins in production and include
# WEB_ORIGIN in CORS_ALLOWED_ORIGINS. Serve frontend/API on the same site.

# Optional email delivery. Missing credentials log links only in development/test.
RESEND_API_KEY=""
MAIL_FROM="Celestia <noreply@example.com>"

# Optional social sign-in. Register exact callback URLs with each provider:
# API_ORIGIN/api/v1/auth/oauth/discord/callback
# API_ORIGIN/api/v1/auth/oauth/google/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional HoYoLAB session encryption. Keep unset until the migration is deployed.
# Generate 32 random bytes encoded as canonical base64, independently of JWT_SECRET.
# HOYOLAB_SESSION_KEY=your-base64-key
