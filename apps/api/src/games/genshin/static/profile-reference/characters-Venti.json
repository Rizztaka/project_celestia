{
  "contractVersion": 1,
  "key": "Venti",
  "gameId": 10000022,
  "name": "Venti",
  "description": "One of the many bards of Mondstadt, who freely wanders the city's streets and alleys.",
  "element": "Anemo",
  "weaponType": "Bow",
  "rarity": 5,
  "forms": [],
  "talents": [
    {
      "key": "combat1",
      "name": "Divine Marksmanship",
      "description": "Normal Attack\nPerforms up to 6 consecutive shots with a bow.\n\nCharged Attack\nPerforms a more precise Aimed Shot with increased DMG.\nWhile aiming, favorable winds will accumulate on the arrowhead. A fully charged wind arrow will deal Anemo DMG.\n\nPlunging Attack\nFires off a shower of arrows in mid-air before falling and striking the ground, dealing AoE DMG upon impact.",
      "kind": "normal",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat2",
      "name": "Skyward Sonnet",
      "description": "O wind upon which all hymns and songs fly, bear these earth-walkers up into the sky!\n\nPress\nSummons a Wind Domain at the opponent's location, dealing AoE Anemo DMG and launching opponents into the air.\n\nHold\nSummons an even larger Wind Domain with Venti as the epicenter, dealing AoE Anemo DMG and launching affected opponents into the air.\nAfter unleashing the Hold version of this ability, Venti rides the wind into the air.\n\nOpponents hit by Skyward Sonnet will fall to the ground slowly.",
      "kind": "skill",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat3",
      "name": "Wind's Grand Ode",
      "description": "Fires off an arrow made of countless coalesced winds, creating a huge Stormeye that sucks in opponents and deals continuous Anemo DMG.\n\nElemental Absorption\nIf the Stormeye comes into contact with Hydro/Pyro/Cryo/Electro, it will deal additional elemental DMG of that type.\nElemental Absorption may only occur once per use.",
      "kind": "burst",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive1",
      "name": "Embrace of Winds",
      "description": "Holding Skyward Sonnet creates an upcurrent that lasts for 20s.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive2",
      "name": "Stormeye",
      "description": "Regenerates 15 Energy for Venti after the effects of Wind's Grand Ode end.\nIf an Elemental Absorption occurred, this also restores 15 Energy to all characters of that corresponding element in the party.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive3",
      "name": "Windrider",
      "description": "Decreases gliding Stamina consumption for your own party members by 20%.\nNot stackable with Passive Talents that provide the exact same effects.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    }
  ],
  "constellations": [
    {
      "key": "c1",
      "name": "Splitting Gales",
      "description": "Fires 2 additional arrows per Aimed Shot, each dealing 33% of the original arrow's DMG.",
      "kind": "constellation",
      "constellation": 1,
      "unlock": "constellation"
    },
    {
      "key": "c2",
      "name": "Breeze of Reminiscence",
      "description": "Skyward Sonnet decreases opponents' Anemo RES and Physical RES by 12% for 10s.\nOpponents launched by Skyward Sonnet suffer an additional 12% Anemo RES and Physical RES decrease while airborne.",
      "kind": "constellation",
      "constellation": 2,
      "unlock": "constellation"
    },
    {
      "key": "c3",
      "name": "Ode to Thousand Winds",
      "description": "Increases the Level of Wind's Grand Ode by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 3,
      "unlock": "constellation"
    },
    {
      "key": "c4",
      "name": "Hurricane of Freedom",
      "description": "When Venti picks up an Elemental Orb or Particle, he receives a 25% Anemo DMG Bonus for 10s.",
      "kind": "constellation",
      "constellation": 4,
      "unlock": "constellation"
    },
    {
      "key": "c5",
      "name": "Concerto dal Cielo",
      "description": "Increases the Level of Skyward Sonnet by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 5,
      "unlock": "constellation"
    },
    {
      "key": "c6",
      "name": "Storm of Defiance",
      "description": "Targets who take DMG from Wind's Grand Ode have their Anemo RES decreased by 20%.\nIf an Elemental Absorption occurred, then their RES towards the corresponding Element is also decreased by 20%.",
      "kind": "constellation",
      "constellation": 6,
      "unlock": "constellation"
    }
  ],
