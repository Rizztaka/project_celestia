{
  "contractVersion": 1,
  "key": "Barbara",
  "gameId": 10000014,
  "name": "Barbara",
  "description": "Every citizen of Mondstadt adores Barbara. She learned the word \"idol\" from a magazine.",
  "element": "Hydro",
  "weaponType": "Catalyst",
  "rarity": 4,
  "forms": [],
  "talents": [
    {
      "key": "combat1",
      "name": "Whisper of Water",
      "description": "Normal Attack\nPerforms up to 4 water splash attacks that deal Hydro DMG.\n\nCharged Attack\nConsumes a certain amount of Stamina to deal AoE Hydro DMG after a short casting time.\n\nPlunging Attack\nGathering the might of Hydro, Barbara plunges towards the ground from mid-air, damaging all opponents in her path. Deals AoE Hydro DMG upon impact with the ground.",
      "kind": "normal",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat2",
      "name": "Let the Show Begin♪",
      "description": "Summons water droplets resembling musical notes that form a Melody Loop, dealing Hydro DMG to surrounding opponents and applying the Wet status to them.\n\nMelody Loop\n·On hit, Barbara's Normal Attacks heal your own party members and nearby teammates for a certain amount of HP, which scales with Barbara's Max HP.\n·On hit, Barbara's Charged Attack generates 4 times the amount of healing.\n·Periodically regenerates your own active character's HP.\n·Applies the Wet status to the character and to opponents who come in contact with them.",
      "kind": "skill",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat3",
      "name": "Shining Miracle♪",
      "description": "Heals your own party members and nearby teammates for a large amount of HP that scales with Barbara's Max HP.",
      "kind": "burst",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive1",
      "name": "Glorious Season",
      "description": "The Stamina Consumption of characters within Let the Show Begin♪'s Melody Loop is reduced by 12%.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive2",
      "name": "Encore",
      "description": "When your active character gains an Elemental Orb/Particle, the duration of the Melody Loop of Let the Show Begin♪ is extended by 1s.\nThe maximum extension is 5s.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive3",
      "name": "With My Whole Heart♪",
      "description": "When a Perfect Cooking is achieved on a dish with restorative effects, there is a 12% chance to obtain double the product.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    }
  ],
  "constellations": [
    {
      "key": "c1",
      "name": "Gleeful Songs",
      "description": "Barbara regenerates 1 Energy every 10s.",
      "kind": "constellation",
      "constellation": 1,
