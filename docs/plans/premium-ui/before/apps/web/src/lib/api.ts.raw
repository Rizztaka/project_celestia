    rank: string;
  };
  elementalSpread: ElementalSpread[];
  analysedAt: string;
}

/**
 * fetchProgressionIntelligence — GET /games/genshin/intelligence/progression
 * Returns high-level account progression metrics.
 */
export async function fetchProgressionIntelligence(): Promise<ProgressionIntelligenceResponse> {
  return fetchApi<ProgressionIntelligenceResponse>('/games/genshin/intelligence/progression');
}



export async function previewTheaterCast(
  payload: import('@celestia/api-contracts').TheaterCastRequest,
  signal?: AbortSignal,
  session?: AccountSession,
): Promise<import('@celestia/api-contracts').TheaterCastResponse> {
  return fetchApi(
    '/games/genshin/endgame/theater/cast-preview',
    {
      method: 'POST',
      body: JSON.stringify(payload),
      signal,
    },
    session,
  );
}

export async function fetchKqmGuide(
  characterKey: string,
  signal?: AbortSignal,
): Promise<KqmCharacterGuide> {
  return fetchApi<KqmCharacterGuide>(
    `/games/genshin/kqm/guides/${encodeURIComponent(characterKey)}`,
    { signal },
  );
}

export async function fetchKqmGuidesList(
  query?: string,
  signal?: AbortSignal,
): Promise<KqmGuideSummary[]> {
  const q = query ? `?q=${encodeURIComponent(query)}` : '';
  return fetchApi<KqmGuideSummary[]>(`/games/genshin/kqm/guides${q}`, { signal });
}

