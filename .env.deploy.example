# Copy to .env for Docker Compose and replace these placeholders.
# Encode reserved URL characters in POSTGRES_PASSWORD, because it is also in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=https://celestia.example.com
API_ORIGIN=https://celestia.example.com

# HoYoLAB: set only after applying the connection migration. Independent canonical
# base64 encoding of 32 cryptographically random bytes; never reuse JWT_SECRET.
# HOYOLAB_SESSION_KEY=
