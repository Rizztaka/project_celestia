import { createRequire } from 'node:module';
import { fileURLToPath } from 'node:url';
Object.assign(process.env,{ NODE_ENV:'test', DOTENV_CONFIG_PATH:'NUL', DATABASE_URL:'postgresql://synthetic:synthetic@127.0.0.1:1/never_connected',JWT_SECRET:'local-preview-only-no-authentication-or-database' });
const root = new URL('../../../',import.meta.url);
const webRequire=createRequire(new URL('apps/web/package.json',root));
const apiRequire=createRequire(new URL('apps/api/package.json',root));
const express=apiRequire('express');
const {createServer}=webRequire('vite');
const {BuildInsightsService}=await import('../../../apps/api/src/games/genshin/intelligence/build-insights/build-insights.service.ts');
const svc=new BuildInsightsService({readForUser:async()=>({character:{characterKey:'Albedo'},weapon:{weaponKey:'HarbingerOfDawn',refinement:5},artifacts:['flower','plume','sands','goblet'].map(slotKey=>({slotKey,setKey:'DeepwoodMemories'})),receipts:[],weaponRelationConsistent:true,artifactRelationsConsistent:true}) as never});
const {buildInsightQuerySchema}=await import('../../../packages/api-contracts/dist/index.js');
const app=express();
app.get('/api/v1/games/genshin/characters/:key/build-insights',async(req,res)=>{try{res.json({success:true,data:await svc.read('local-fixture',req.params.key,buildInsightQuerySchema.parse(req.query))});}catch{res.status(400).json({success:false});}});
const api=app.listen(45462,'127.0.0.1');
const vite=await createServer({root:fileURLToPath(new URL('apps/web/',root)),configFile:fileURLToPath(new URL('apps/web/vite.config.ts',root)),define:{'import.meta.env.VITE_API_URL':JSON.stringify('http://127.0.0.1:45461/api/v1')},server:{host:'127.0.0.1',port:45461,strictPort:true,proxy:{'/api':{target:'http://127.0.0.1:45462'}}}});
vite.middlewares.use('/__insights-review',(_req,res)=>{res.setHeader('Content-Type','text/html');res.end('<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><script type="module">import RefreshRuntime from "/@react-refresh"; RefreshRuntime.injectIntoGlobalHook(window); window.$RefreshReg$=()=>{}; window.$RefreshSig$=()=>type=>type; window.__vite_plugin_react_preamble_installed__=true;</script></head><body style="background:#0a0a0c"><div id="root"></div><script type="module" src="/src/build-insights-review.tsx"></script></body></html>');});
await vite.listen();
console.log('Local fixture ready at http://127.0.0.1:45461/__insights-review');
const close=async()=>{await vite.close();api.close();process.exit(0);};
process.on('SIGINT',close);process.on('SIGTERM',close);
