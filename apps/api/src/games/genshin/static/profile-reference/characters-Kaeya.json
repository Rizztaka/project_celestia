{
  "contractVersion": 1,
  "key": "Kaeya",
  "gameId": 10000015,
  "name": "Kaeya",
  "description": "An accomplished swordsman and a strategic thinker in the Knights of Favonius, rumored to hail from beyond Mondstadt.",
  "element": "Cryo",
  "weaponType": "Sword",
  "rarity": 4,
  "forms": [],
  "talents": [
    {
      "key": "combat1",
      "name": "Ceremonial Bladework",
      "description": "Normal Attack\nPerforms up to 5 rapid strikes.\n\nCharged Attack\nConsumes a certain amount of Stamina to unleash 2 rapid sword strikes.\n\nPlunging Attack\nPlunges from mid-air to strike the ground below, damaging opponents along the path and dealing AoE DMG upon impact.",
      "kind": "normal",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat2",
      "name": "Frostgnaw",
      "description": "Unleashes a frigid blast, dealing Cryo DMG to opponents in front of Kaeya.",
      "kind": "skill",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat3",
      "name": "Glacial Waltz",
      "description": "Coalescing the frost in the air, Kaeya summons 3 icicles that revolve around him.\nThese icicles will follow the character around and deal Cryo DMG to opponents in their path for the ability's duration.",
      "kind": "burst",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive1",
      "name": "Cold-Blooded Strike",
      "description": "Every hit with Frostgnaw regenerates HP for Kaeya equal to 15% of his ATK.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive2",
      "name": "Glacial Heart",
      "description": "Opponents Frozen by Frostgnaw will drop additional Elemental Particles.\nFrostgnaw may only produce a maximum of 2 additional Elemental Particles per use.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive3",
      "name": "Hidden Strength",
      "description": "Decreases sprinting Stamina consumption for your own party members by 20%.\nNot stackable with Passive Talents that provide the exact same effects.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    }
  ],
  "constellations": [
    {
      "key": "c1",
      "name": "Excellent Blood",
      "description": "The CRIT Rate of Kaeya's Normal and Charge Attacks against opponents affected by Cryo is increased by 15%.",
      "kind": "constellation",
      "constellation": 1,
      "unlock": "constellation"
    },
    {
      "key": "c2",
      "name": "Never-Ending Performance",
      "description": "While Glacial Waltz is in effect, for each opponent defeated, its duration is increased by 2.5s, up to a maximum of 15s.",
      "kind": "constellation",
      "constellation": 2,
      "unlock": "constellation"
    },
    {
      "key": "c3",
      "name": "Dance of Frost",
      "description": "Increases the Level of Frostgnaw by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 3,
      "unlock": "constellation"
    },
    {
      "key": "c4",
      "name": "Frozen Kiss",
      "description": "Triggers automatically when Kaeya's HP falls below 20%:\nCreates a shield that absorbs damage equal to 30% of Kaeya's Max HP. Lasts for 20s.\nThis shield absorbs Cryo DMG with 250% efficiency.\nCan only occur once every 60s.",
      "kind": "constellation",
      "constellation": 4,
      "unlock": "constellation"
    },
    {
      "key": "c5",
      "name": "Frostbiting Embrace",
      "description": "Increases the Level of Glacial Waltz by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 5,
      "unlock": "constellation"
    },
    {
      "key": "c6",
      "name": "Glacial Whirlwind",
      "description": "Glacial Waltz will generate 1 additional icicle, and will regenerate 15 Energy when cast.",
      "kind": "constellation",
      "constellation": 6,
      "unlock": "constellation"
    }
