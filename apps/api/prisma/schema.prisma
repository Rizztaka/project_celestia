generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// PLATFORM DOMAIN
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  oauthAccounts OAuthAccount[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  // Back-relation to Genshin domain — no column is added to the users table.
  // One user has at most one Genshin account in Phase 2.
  genshinAccount GenshinAccount?
  genshinHoyolabConnection GenshinHoyolabConnection?

  // Back-relation to NIKKE domain (Phase 7).
  nikkeAccount NikkeAccount?

  // Back-relation to the Daily Companion (Phase 3). Frozen after C2a cutover.
  dailyCompanion DailyCompanion?

  // Back-relation to the C2a routine state. Owned by userId, no game FK.
  genshinRoutineState GenshinRoutineState?
  genshinPlanPreferences GenshinPlanPreferences?
  genshinPlanDismissals GenshinPlanDismissal[]

  // Back-relation to upgrade goals (Phase 3B).
  upgradeGoals   UpgradeGoal[]

  // Back-relation to event progress (Phase 3C).
  eventProgress  EventProgress[]

  // Back-relation to weekly boss state (Phase 3D). Frozen after C2a cutover.
  weeklyBossState WeeklyBossState?

  @@map("users")
}

model Session {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedTokens RotatedRefreshToken[]
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Retained hashes associate replayed tokens with the session/user after rotation.
model RotatedRefreshToken {
  tokenHash String @id
  sessionId String
  expiresAt DateTime
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@index([expiresAt])
  @@map("rotated_refresh_tokens")
}

model OAuthAccount {
  id String @id @default(uuid())
  userId String
  provider String
  providerAccountId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ==========================================
// PLATFORM COMPANION (C2a)
// ==========================================

/// Authoritative routine state for a user's Genshin companion.
/// One-to-one with User. Created only on the first explicit PATCH — never on GET.
/// No GenshinAccount or equipment foreign keys; useful before any import.
///
/// Database CHECK constraints (applied in the migration):
///   revision >= 0
///   server_id IN ('asia') OR server_id IS NULL
///   (resin_amount IS NULL) = (resin_recorded_at IS NULL)
///   resin_amount IS NULL OR (resin_amount >= 0 AND resin_amount <= 200)
///   weekly_reward_claims IS NULL OR weekly_reward_claims >= 0
///
/// Period fields store the exact UTC boundary of the period for which the
/// stored flags/claims are valid. A period mismatch projects flags as false
/// (daily) or claims as null (weekly) — no reset write occurs on GET.
model GenshinRoutineState {
  /// Primary key and owner — no separate synthetic ID.
  userId String @id

  /// Monotonically increasing; 0 = default in-memory value (no row yet).
  /// Every accepted mutation increments exactly once.
  revision Int @default(0)

  /// Selected game server. Only 'asia' is supported in C2a.
  /// null = user has not completed setup.
  serverId String?

  // ── Daily state ──────────────────────────────────────────────────────────

  /// UTC boundary that defines the period for the stored daily flags.
  /// null = no period has been saved yet.
  dailyPeriodStart DateTime?

  /// Daily commissions completed. Only meaningful when dailyPeriodStart
  /// matches the current period; projected as false on mismatch.
  commissionsDone Boolean @default(false)

  /// Teapot reminder checked. Same semantics as commissionsDone.
  teapotChecked Boolean @default(false)

  // ── Transformer (manual) ─────────────────────────────────────────────────

  /// UTC timestamp of the last explicit "Record use now" action.
  /// null = never recorded or explicitly cleared.
  /// Never modified by period resets.
  transformerLastUsedAt DateTime?

  // ── Resin checkpoint ─────────────────────────────────────────────────────

  /// Resin amount at the time it was recorded. 0–200.
  /// null when resinRecordedAt is null (paired nullability enforced in DB).
  resinAmount Int?

  /// UTC timestamp of when resinAmount was recorded.
  /// null when resinAmount is null.
  resinRecordedAt DateTime?

  // ── Weekly state ──────────────────────────────────────────────────────────

  /// UTC boundary that defines the period for the stored weekly claim total.
  /// null = no period has been saved yet.
  weeklyPeriodStart DateTime?

  /// User-confirmed count of boss reward claims collected this week.
  /// null = unknown for this week (new week or never entered).
  /// 0 = user has explicitly confirmed zero claims.
  weeklyRewardClaims Int?

  // ── Timestamps ───────────────────────────────────────────────────────────

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("genshin_routine_state")
}

// ==========================================
// GENSHIN DOMAIN
// ==========================================

/// Links a platform User to their Genshin Impact data.
/// One user = one Genshin account in Phase 2 (enforced by @unique on userId).
/// Phase 6 will remove @unique to support multi-account.
model GenshinAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  uid           String?  // in-game UID (9 digits), optional until importer runs (2B)
  nickname      String?  // in-game traveler nickname
  adventureRank Int?
  worldLevel    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters      GenshinCharacter[]
  weapons         GenshinWeapon[]
  artifacts       GenshinArtifact[]
  materials       GenshinMaterial[]       // Phase 3B — material inventory from GOOD import
  importStates    GenshinImportSectionState[]
  spiralAbyssRuns SpiralAbyssRun[]        // Phase 5A — endgame abyss tracking
  theaterRuns     ImaginariumTheaterRun[] // Phase 5C — endgame theater tracking

  @@map("genshin_accounts")
}

enum GenshinImportSection {
  characters
  weapons
  artifacts
  materials
}

/// Latest successful import per section. Missing rows mean unknown provenance.
/// importedAt is receipt time in Celestia, not observation time in the game.
model GenshinImportSectionState {
  id         String @id @default(uuid())
  accountId  String
  section    GenshinImportSection
  importedAt DateTime
  source     String?
  entryCount Int
  account    GenshinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, section])
  @@map("genshin_import_sections")
}

/// A single character owned by the player.
/// characterKey maps to static game data JSON (e.g. "hutao", "raiden_shogun").
/// Talent values are stored as supplied. Persistence does not establish their
/// base/effective convention or whether an individual value came from a default.
model GenshinCharacter {
  dataSource String @default("manual")
  id               String  @id @default(uuid())
  accountId        String
  characterKey     String  // references static game data, NOT a FK
  level            Int     // 1–90
  ascension        Int?    // Unknown when HoYoLAB omits the level cap
  constellation    Int     // 0–6
  talentNormal     Int     // 1–10 (base level)
  talentSkill      Int     // 1–10 (base level)
  talentBurst      Int     // 1–10 (base level)
  active           Boolean @default(true)
  equippedWeaponId String? @unique // 1:1 with GenshinWeapon; null = no weapon equipped

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account           GenshinAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equippedWeapon    GenshinWeapon?    @relation(fields: [equippedWeaponId], references: [id])
  equippedArtifacts GenshinArtifact[] // up to 5 (one per slot), enforced by unique index below
  focus             GenshinCharacterFocus?

  @@unique([accountId, characterKey]) // a character can only appear once per account
  @@map("genshin_characters")
}

/// A weapon in the player's inventory.
/// weaponKey maps to static game data (e.g. "StaffOfHoma").
model GenshinWeapon {
  id         String  @id @default(uuid())
  accountId  String
  weaponKey  String  // references static game data, NOT a FK
  level      Int     // 1–90
  ascension  Int?    // Unknown when HoYoLAB omits the level cap
  refinement Int     // 1–5
  locked     Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account    GenshinAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equippedBy GenshinCharacter? // back-relation from GenshinCharacter.equippedWeaponId

  @@map("genshin_weapons")
}

/// A single artifact in the player's inventory.
/// setKey, slotKey, and mainStatKey reference static game data constants.
/// subStats are stored as JSON: [{ key: "critRate_", value: 6.6 }, ...]
/// equippedCharacterId is null when the artifact is in inventory but not equipped.
model GenshinArtifact {
  id                  String  @id @default(uuid())
  accountId           String
  setKey              String  // e.g. "ShimenawasReminiscence"
  slotKey             String  // "flower" | "plume" | "sands" | "goblet" | "circlet"
  level               Int     // 0–20
  rarity              Int     // 1–5 (star count)
  mainStatKey         String  // e.g. "hp", "atk", "critRate_", "eleMas"
  subStats            Json    @default("[]") // ArtifactSubStat[]
  locked              Boolean? @default(false)
  mainStatValue       Float?
  equippedCharacterId String? // FK to GenshinCharacter.id; null = in inventory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account    GenshinAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equippedBy GenshinCharacter? @relation(fields: [equippedCharacterId], references: [id])

  // A character cannot have two artifacts in the same slot.
  // NULLs are treated as distinct by PostgreSQL, so multiple unequipped
  // artifacts with the same slotKey are correctly allowed.
  @@unique([equippedCharacterId, slotKey])
  @@map("genshin_artifacts")
}

// ==========================================
// ENDGAME DOMAIN (Phase 5)
// ==========================================

/// Records a single half-chamber attempt in the Spiral Abyss for one cycle.
/// cycleId encodes the game version + first/second half, e.g. "5.0-1", "5.0-2".
/// Unique constraint prevents logging the same chamber half twice in one cycle
/// — the upsert pattern (logAbyssRun) will update stars/team instead.
///
/// team is stored as a JSON string array of characterKeys:
/// ["HuTao", "Xingqiu", "Yelan", "Zhongli"]
model SpiralAbyssRun {
  id        String   @id @default(uuid())
  accountId String
  cycleId   String   // e.g. "5.0-1" (version + first/second reset)
  floor     Int      // 9–12
  chamber   Int      // 1–3
  half      Int      // 1 or 2
  stars     Int      // 0–3
  team      Json     @default("[]") // string[] of characterKeys

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account GenshinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Prevent duplicate rows for the same chamber slot in one cycle.
  @@unique([accountId, cycleId, floor, chamber, half])
  @@map("spiral_abyss_runs")
}

// ==========================================
// IMAGINARIUM THEATER (Phase 5C)
// ==========================================

enum TheaterDifficulty {
  EASY
  NORMAL
  HARD
  VISIONARY
}

/// Tracks a user's Imaginarium Theater run for a given season.
/// One row per (accountId, seasonId) — upserted if the user improves their score.
/// seasonId is a human-readable string, e.g. "August 2024".
///
/// cast stores the JSON array of characterKeys the player brought into the run.
/// stars is the number of medals/stars earned (0–10).
model ImaginariumTheaterRun {
  id         String            @id @default(uuid())
  accountId  String
  seasonId   String            // e.g. "August 2024"
  difficulty TheaterDifficulty
  actsCleared Int              // 1–10
  stars      Int               // 0–10
  cast       Json @default("[]") // string[] of characterKeys

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account GenshinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // One run per account per season — upsert target.
  @@unique([accountId, seasonId])
  @@map("imaginarium_theater_runs")
}

/// Stores a user's daily companion state: resin tracking and daily checklist.
/// One-to-one with User. Created lazily on the user's first GET request (upsert).
///
/// Resin is tracked as a checkpoint: the stored amount + the time it was set.
/// The effective current amount is projected forward on the frontend using
/// the regeneration rate (1 per 8 minutes, cap 200). No backend polling needed.
///
/// Daily checklist flags are reset lazily when the daily reset boundary
/// (20:00 UTC = 04:00 Asia/Shanghai UTC+8) is detected to have passed
/// since dailyResetAt was last written.
model DailyCompanion {
  id     String @id @default(uuid())
  userId String @unique

  // Resin tracking — checkpoint model
  // resinAmount is the value at the moment resinUpdatedAt was recorded.
  // Do NOT read resinAmount as the "current" value without projecting forward.
  resinAmount    Int      @default(0)    // 0–200
  resinUpdatedAt DateTime @default(now()) // when resinAmount was last set by the user

  // Daily checklist
  commissionsDone    Boolean @default(false)
  teapotClaimed      Boolean @default(false)
  transformerClaimed Boolean @default(false)

  // Tracks the DateTime of the last daily reset that was applied to this record.
  // Used by the lazy reset logic in DailyCompanionService.getDailyState().
  dailyResetAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_companion")
}

// ==========================================
// GENSHIN MATERIAL INVENTORY (Phase 3B)
// ==========================================

/// Stores the player's material inventory as imported from the GOOD format.
/// Fully replaced on every import (delete-all then insert), same as weapons/artifacts.
/// itemKey uses the GOOD format's item key (e.g. "SilkFlower", "WhopperflowerNectar").
model GenshinMaterial {
  id        String @id @default(uuid())
  accountId String
  itemKey   String // GOOD-format item key, references static data — NOT a FK
  quantity  Int    // current stack size

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account GenshinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, itemKey]) // one row per item per account
  @@map("genshin_materials")
}

// ==========================================
// UPGRADE GOALS (Phase 3B)
// ==========================================

/// Goal type discriminator.
enum GoalType {
  CHARACTER_ASCENSION
  CHARACTER_TALENT
  WEAPON_ASCENSION
}

enum GoalStatus {
  active
  paused
  completed
  archived
}

/// False rows retain revision after unfocus; no import or GET writes membership.
model GenshinCharacterFocus {
  accountId    String
  characterKey String
  focused      Boolean @default(false)
  revision     Int @default(0)
  character    GenshinCharacter @relation(fields: [accountId, characterKey], references: [accountId, characterKey], onDelete: Cascade)

  @@id([accountId, characterKey])
  @@map("genshin_character_focus")
}

/// Records a user's intent to upgrade a character or weapon.
/// Goals belong to User (not GenshinAccount) so they survive GOOD re-imports.
/// targetKey is a catalog or owned imported natural/type key, not a database foreign key.
model UpgradeGoal {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goalType   GoalType
  targetKey  String   // e.g. "HuTao", "StaffOfHoma" — references static seed data
  fromPhase  Int      // ascension 0–5; base talent 1–9
  toPhase    Int      // ascension 1–6; base talent 2–10
  talentType String?  // "normal" | "skill" | "burst" — required for CHARACTER_TALENT, else null

  status           GoalStatus @default(active)
  priority         Int @default(3)
  revision         Int @default(0)
  completedAt      DateTime?
  completionReason String?
  createRequestId  String?
  predecessorId    String? @unique
  predecessor      UpgradeGoal? @relation("GoalSuccessor", fields: [predecessorId], references: [id], onDelete: NoAction)
  successor        UpgradeGoal? @relation("GoalSuccessor")
  planDismissals   GenshinPlanDismissal[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Current-intent checks serialize under the owner lock, retaining legacy duplicates.
  @@unique([userId, createRequestId])
  @@unique([userId, id])
  @@index([userId, status, priority, createdAt, id])
  @@map("upgrade_goals")
}

model GenshinPlanPreferences {
  userId String @id
  revision Int @default(0)
  dailyResinBudget Int?
  commissions Boolean @default(false)
  teapot Boolean @default(false)
  transformer Boolean @default(false)
  weeklyClaims Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("genshin_plan_preferences")
}

model GenshinPlanDismissal {
  userId String
  sourceKey String
  scope String
  serverId String
  periodId String
  goalId String?
  goalRevision Int?
  routineKind String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal UpgradeGoal? @relation(fields: [userId, goalId], references: [userId, id], onDelete: Cascade)

  @@id([userId, sourceKey, scope])
  @@index([userId, goalId])
  @@map("genshin_plan_dismissals")
}

// ==========================================
// EVENT PROGRESS (Phase 3C)
// ==========================================

/// Tracks which reward tiers a user has claimed for a time-limited patch event.
/// One row per (userId, eventKey, tierId). Both eventKey and tierId reference
/// the static events.json — they are NOT database foreign keys.
/// Stale rows (from past patches) are harmless and ignored at query time (ADR decision: lazy cleanup).
model EventProgress {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventKey  String  // matches events.json "key" field, e.g. "EchoesOfTheDeep5.8"
  tierId    String  // matches events.json rewardTiers[].tierId, e.g. "t1"
  claimed   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One progress row per (user, event, tier) — upsert target.
  @@unique([userId, eventKey, tierId])
  @@map("event_progress")
}

// ==========================================
// WEEKLY BOSS STATE (Phase 3D)
// ==========================================

/// Tracks a user's weekly boss defeat status for the current week.
/// One-to-one with User. Created lazily on the user's first weekly boss request.
///
/// defeatedBossKeys stores the set of bossKeys defeated this week as a JSON
/// string array (e.g. ["Dvalin", "Lupus"]). JSON storage is used instead of
/// a junction table because the weekly lazy reset (ADR-0009) requires clearing
/// all defeats atomically — a single UPDATE rather than destructive DELETEs
/// that would violate ADR-0010 (GET must not mutate state destructively).
///
/// Weekly reset boundary: Sunday 20:00 UTC (= Monday 04:00 UTC+8 / Asia server).
/// Reset is applied lazily on every GET request, not by a cron job.
model WeeklyBossState {
  id     String @id @default(uuid())
  userId String @unique

  defeatedBossKeys Json     @default("[]") // string[] — keys from weekly-bosses.json
  weeklyResetAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weekly_boss_state")
}

// ==========================================
// NIKKE DOMAIN (PHASE 7)
// ==========================================

model NikkeAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  commanderName String?
  commanderLevel Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters    NikkeCharacter[]
}

model NikkeCharacter {
  id            String   @id @default(uuid())
  accountId     String
  characterKey  String   // Static reference
  level         Int      // 1-200+
  limitBreak    Int      // 0-3+
  coreEnhance   Int      // 0-7
  skill1        Int      // 1-10
  skill2        Int      // 1-10
  burstSkill    Int      // 1-10

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account       NikkeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  equipment     NikkeEquipment[]

  @@unique([accountId, characterKey])
}

model NikkeEquipment {
  id            String   @id @default(uuid())
  characterId   String
  slot          String   // e.g., Head, Torso, Arm, Leg
  tier          Int      // e.g., 9 for T9
  manufacturer  String?  // e.g., Tetra, Missilis, Elysion, Pilgrim
  level         Int      // 1-5
  isOverload    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  character     NikkeCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// Private application data. Data API roles have no grants/policies.
model GenshinHoyolabConnection {
  userId String @id
  encryptedSession String?
  generation Int @default(1)
  roles Json @default("[]")
  selectedUid String?
  selectedServer String?
  state String @default("disconnected")
  syncedAt DateTime?
  nextSyncAt DateTime?
  notes Json?
  leaseId String?
  leaseUntil DateTime?
  lastError String?
  lastAttemptAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([nextSyncAt])
  @@map("genshin_hoyolab_connections")
}
