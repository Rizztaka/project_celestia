      "unlock": "constellation"
    },
    {
      "key": "c5",
      "name": "The Purest Companionship",
      "description": "Increases the Level of Let the Show Begin♪ by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 5,
      "unlock": "constellation"
    },
    {
      "key": "c6",
      "name": "Dedicating Everything to You",
      "description": "When Barbara is in the party but not on the field, and one of your own party members falls:\n·Automatically revives the fallen character.\n·Fully restores the revived character's HP to 100%.\nThis effect can only occur once every 15 mins.",
      "kind": "constellation",
      "constellation": 6,
