{
  "contractVersion": 1,
  "key": "TravelerElectro",
  "gameId": 10000005,
  "name": "Traveler (Electro)",
  "description": "A traveler from another world who had their only kin taken away, forcing them to embark on a journey to find The Seven.",
  "element": "Electro",
  "weaponType": "Sword",
  "rarity": 5,
  "forms": [],
  "talents": [
    {
      "key": "combat1",
      "name": "Foreign Thundershock",
      "description": "Normal Attack\nPerforms up to 5 rapid strikes.\n\nCharged Attack\nConsumes a certain amount of Stamina to unleash 2 rapid sword strikes.\n\nPlunging Attack\nPlunges from mid-air to strike the ground below, damaging opponents along the path and dealing AoE DMG upon impact.",
      "kind": "normal",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat2",
      "name": "Lightning Blade",
      "description": "Unleashes three swift thunder shadows that deal Electro DMG to opponents and leave an Abundance Amulet behind after hitting an opponent.\n2 Abundance Amulets can be created initially. Using this skill will reset any Abundance Amulets that were generated.\n\nAbundance Amulets\nWhen a character is near an Abundance Amulet, they will absorb it and obtain the following effects:\n·Restores Elemental Energy\n·Increases Energy Recharge during the Abundance Amulet's duration.",
      "kind": "skill",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "combat3",
      "name": "Bellowing Thunder",
      "description": "You call upon the protection of lightning, knocking nearby opponents back and dealing Electro DMG to them.\n\nLightning Shroud\nWhen your active character's Normal or Charged Attacks hit opponents, they will call Falling Thunder forth, dealing Electro DMG.\nWhen Falling Thunder hits opponents, it will regenerate Energy for that character.\nOne instance of Falling Thunder can be generated every 0.5s.",
      "kind": "burst",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive1",
      "name": "Thunderflash",
      "description": "When another nearby character in the party obtains an Abundance Amulet created by Lightning Blade, Lightning Blade's CD is decreased by 1.5s.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    },
    {
      "key": "passive2",
      "name": "Resounding Roar",
      "description": "Increases the Energy Recharge effect granted by Lightning Blade's Abundance Amulet by 10% of the Traveler's Energy Recharge.",
      "kind": "passive",
      "constellation": null,
      "unlock": "unknown"
    }
  ],
  "constellations": [
    {
      "key": "c1",
      "name": "Spring Thunder of Fertility",
      "description": "The number of Abundance Amulets that can be generated using Lightning Blade is increased to 3.",
      "kind": "constellation",
      "constellation": 1,
      "unlock": "constellation"
    },
    {
      "key": "c2",
      "name": "Violet Vehemence",
      "description": "When Falling Thunder created by Bellowing Thunder hits an opponent, it will decrease their Electro RES by 15% for 8s.",
      "kind": "constellation",
      "constellation": 2,
      "unlock": "constellation"
    },
    {
      "key": "c3",
      "name": "Distant Crackling",
      "description": "Increases the Level of Bellowing Thunder by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 3,
      "unlock": "constellation"
    },
    {
      "key": "c4",
      "name": "Fickle Cloudstrike",
      "description": "When a character obtains Abundance Amulets generated by Lightning Blade, if this character's Energy is less than 35%, the Energy restored by the Abundance Amulets is increased by 100%.",
      "kind": "constellation",
      "constellation": 4,
      "unlock": "constellation"
    },
    {
      "key": "c5",
      "name": "Clamor in the Wilds",
      "description": "Increases the Level of Lightning Blade by 3.\nMaximum upgrade level is 15.",
      "kind": "constellation",
      "constellation": 5,
      "unlock": "constellation"
    },
    {
      "key": "c6",
      "name": "World-Shaker",
      "description": "Every 2 Falling Thunder attacks triggered by Bellowing Thunder will greatly increase the DMG dealt by the next Falling Thunder, which will deal 200% of its original DMG and will restore an additional 1 Energy to the current character.",
      "kind": "constellation",
      "constellation": 6,
      "unlock": "constellation"
    }
  ],
