import { Router } from 'express';

import { requireAuth } from '@/core/middleware/auth.middleware.js';
import type { RequestSafety } from '@/core/middleware/request-admission.js';

import { aiSummary } from './ai-advice.controller.js';
import {
  askCharacter,
  characterKnowledgeMetadata,
  characterKnowledgeObservation,
} from './character-knowledge/advisor.controller.js';

export function createAiAdviceRoutes(safety: RequestSafety) {
  const router = Router();
  router.get('/character-knowledge/observation', requireAuth, characterKnowledgeObservation);
  router.get('/character-knowledge/:key', requireAuth, characterKnowledgeMetadata);
  router.post('/intelligence/character-advisor', requireAuth, safety.aiSummary(askCharacter));
  router.post('/intelligence/ai-summary', requireAuth, safety.aiSummary(aiSummary));
  return router;
}
